# Copy to `.env` (cp .env.example .env). Never commit `.env`.
# Must match docker-compose.yml.
DATABASE_URL=postgresql://app:app@localhost:5433/app
PORT=3000
NODE_ENV=development
# Origin(s) allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173
# Signs login tokens. 32+ random characters (openssl rand -hex 32). Never commit the real value.
JWT_SECRET=change-me-to-at-least-32-random-characters
